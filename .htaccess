# ==============================================================================
# Apache & WAF Configuration for Mwana Lari SaaS (www.cmd.cg)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # 1. Force HTTPS Redirection
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent directory listing & dotfiles access
  Options -Indexes
  RewriteRule ^\.(git|env|htaccess|user\.ini|sqlite|db|bak) - [F,L]

  # 3. Web Application Firewall (WAF) - Block Malicious Scanners & User-Agents
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|dirbuster|gobuster|masscan|acunetix|havij|nmap|zgrab) [NC]
  RewriteRule ^ - [F,L]

  # 4. Web Application Firewall (WAF) - Block SQL Injection Patterns in Query String
  RewriteCond %{QUERY_STRING} (union.*select|insert.*into|benchmark\(|waitfor.*delay|information_schema|<script|javascript:|onerror=) [NC]
  RewriteRule ^ - [F,L]

  # 5. Direct serving of existing files/folders, fallback to local index.html (Works at root & in subfolders like /mwanalari/)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# Security Headers (OWASP, ASVS & PCI-DSS Best Practices)
# ==============================================================================
<IfModule mod_headers.c>
  # Clickjacking Protection
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # MIME Sniffing Prevention
  Header always set X-Content-Type-Options "nosniff"
  
  # Cross-Site Scripting Protection & Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  
  # Hardware & Permissions Policy (Microphone strictly for pronunciation lab)
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(self)"
  
  # HTTP Strict Transport Security (HSTS - 1 year with subdomains and preload)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://mwana-lari-api.onrender.com http://localhost:8000; img-src 'self' data: https: blob:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
</IfModule>

# ==============================================================================
# Caching for audio & assets
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType audio/wav "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# ==============================================================================
# Gzip Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json
</IfModule>
