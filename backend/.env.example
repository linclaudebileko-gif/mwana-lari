PROJECT_NAME="Mwana Lari API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./mwana_lari.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql+psycopg2://mwana_user:mwana_secret@localhost:5432/mwana_lari_db"

# JWT Authentication
SECRET_KEY="remplacer_par_une_cle_secrete_jwt_aleatoire_et_complexe"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ENVIRONMENT="development"

# Mobile Money Congo (Integration Directe API)
# MTN Mobile Money Open API
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com" # Ou https://proxy.momoapi.mtn.com en production
MTN_MOMO_SUBSCRIPTION_KEY="votre_cle_d_abonnement_mtn"
MTN_MOMO_API_USER="votre_api_user_uuid"
MTN_MOMO_API_KEY="votre_api_key_secret"
MTN_MOMO_TARGET_ENV="sandbox" # Ou 'mtncongo' en production

# Airtel Money Africa Open API (Congo XAF)
AIRTEL_MONEY_BASE_URL="https://openapi.airtel.africa"
AIRTEL_MONEY_CLIENT_ID="votre_client_id_airtel"
AIRTEL_MONEY_CLIENT_SECRET="votre_client_secret_airtel"
AIRTEL_MONEY_COUNTRY="CG"
# OpenPay Congo Payment Gateway (MTN MoMo & Airtel Money)
OPENPAY_API_KEY="votre_cle_api_secrete_openpay"
OPENPAY_BASE_URL="https://api.openpay-cg.com/v1"

WEBHOOK_SECRET="votre_secret_webhook_partage"
