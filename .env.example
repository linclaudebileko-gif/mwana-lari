# ===================================================================
# Modèle de variables d'environnement Mwana Lari (.env.example)
# AUCUNE donnée sensible ou mot de passe réel ne doit figurer dans ce fichier.
# ===================================================================

# --- Frontend & Client API ---
# URL de l'API Backend (Render, VPS ou localhost)
VITE_API_URL=http://localhost:8000/api/v1

# --- Service d'Envoi d'Emails (Vercel Serverless Function & Backend) ---
# Identifiants SMTP sécurisés (Variables SERVEUR uniquement - JAMAIS VITE_*)
EMAIL_USER=contact@mwanalari.cg
EMAIL_PASSWORD=votre_mot_de_passe_application_smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
CONTACT_DESTINATION_EMAIL=contact@mwanalari.cg

# --- Backend FastAPI & Base de Données ---
PROJECT_NAME="Mwana Lari API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Base de données (SQLite en local ou PostgreSQL hébergé en production)
DATABASE_URL="sqlite:///./mwana_lari.db"
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/mwana_lari_db"

# Clé de chiffrement des tokens JWT
SECRET_KEY=votre_cle_secrete_jwt_generee_aleatoirement
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=https://mwanalari.cg,https://www.cmd.cg,http://localhost:5173

# Mot de passe par défaut pour initialisation administrateur (facultatif)
DEFAULT_ADMIN_PASSWORD=votre_mot_de_passe_admin_securise
DEMO_USERS_PASSWORD=votre_mot_de_passe_demo_securise

# --- Passerelle OpenPay Congo (MTN MoMo & Airtel Money) ---
OPENPAY_API_KEY=votre_cle_api_secrete_openpay
OPENPAY_BASE_URL=https://api.openpay-cg.com/v1

